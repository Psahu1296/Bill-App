# ── Server ────────────────────────────────────────────────────────────────────
PORT=5002
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dhaba-pos?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string

# ── Frontend URLs ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CUSTOMER_APP_URL=https://sahudhaba.in

# ── PhonePe Payment Gateway ───────────────────────────────────────────────────
# Get credentials from PhonePe merchant dashboard
# Use UAT values for testing, replace with PRODUCTION for live
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=your_phonepe_salt_key
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT

# ── Firebase Admin (for ID token verification) ────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── GitHub (required when repo is private) ────────────────────────────────────
# Fine-grained PAT: repo → Contents: Read-only
# Used by /api/updates/releases to proxy release notes to the frontend
GH_TOKEN=github_pat_xxxxxxxxxxxx
